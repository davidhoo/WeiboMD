{
  "manifest_version": 3,
  "name": "WeiboMD",
  "version": "1.0.0",
  "description": "在微博中渲染 Markdown 格式内容",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://weibo.com/*", "*://www.weibo.com/*", "*://d.weibo.com/*"],
      "js": ["marked.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
